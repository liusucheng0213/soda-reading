# Web fallback API, used only when Supabase variables are absent.
VITE_API_BASE=http://127.0.0.1:8000

# Safe to expose in a browser: the anon key is constrained by RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# The public reader build should set this to false in Cloudflare Pages.
VITE_ENABLE_ADMIN=false
