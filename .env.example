# 复制为项目根目录的 .env。Vite 只把 VITE_ 开头的变量暴露给网页。
# 密钥留空。带默认值的项保持注释：写成空字符串会覆盖代码默认，整数项还会导致启动失败。

# 本地 FastAPI。不设置时前端使用 http://127.0.0.1:8000
# VITE_API_BASE=http://127.0.0.1:8000

# 设为 false 时，浏览器打开 /admin 会回到阅读端
# VITE_ENABLE_ADMIN=false

# 本地开发用户名，留空则使用 admin；须与 backend/.env 的 LOCAL_ADMIN_USERNAME 一致
VITE_LOCAL_ADMIN_USERNAME=

# 本地开发密码，至少 8 位，须与 backend/.env 的 LOCAL_ADMIN_PASSWORD 一致；不要使用真实密码
# 此值只用于本机开发回退；生产构建不会启用该回退
VITE_LOCAL_ADMIN_PASSWORD=

# 本地开发短信码，自行设定 6 位数字，须与 backend/.env 的 DEV_SMS_CODE 一致
VITE_DEV_SMS_CODE=
