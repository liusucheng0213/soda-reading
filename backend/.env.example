# 复制为 backend/.env，并在 backend 目录启动 API。
# 密钥留空。带默认值的项保持注释：空字符串会覆盖代码默认，数字项写成空值会导致启动失败。

# 运行环境。development 开放本地登录与开发短信；其他值会关闭这两条入口。默认 development
# APP_ENV=development

# 本地开发短信码，自行设定 6 位数字，仅 development 环境有效
DEV_SMS_CODE=

# 本地登录用户名。默认 admin
# LOCAL_ADMIN_USERNAME=admin

# 本地登录密码，至少 8 位；不要使用真实密码
LOCAL_ADMIN_PASSWORD=

# 非 development 环境的管理接口令牌，请求头为 X-Admin-Token
ADMIN_API_TOKEN=

# 允许的浏览器来源，逗号分隔。默认 http://localhost:4173,http://127.0.0.1:4173
# ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# ModelScope Access Token：https://modelscope.cn/my/myaccesstoken
MODELSCOPE_ACCESS_TOKEN=
# MODELSCOPE_MODEL=Qwen/Qwen3.5-35B-A3B

# 智谱 API Key：https://bigmodel.cn/usercenter/proj-mgmt/apikeys
ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4.7-flash

# 硅基流动 API Key：https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=
# SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# 腾讯云访问密钥：https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# TENCENT_REGION=ap-guangzhou

# 百炼 API Key：https://help.aliyun.com/zh/model-studio/get-api-key/
DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-mt-flash

# DeepSeek API Key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# 词译提供方顺序。默认 deepseek
# TRANSLATION_PROVIDER_ORDER=deepseek
# TRANSLATION_PROVIDER_TIMEOUT_MS=8000
# TRANSLATION_TOTAL_TIMEOUT_MS=12000
# TRANSLATION_CACHE_TTL_SECONDS=2592000
# TRANSLATION_FAILURE_TTL_SECONDS=8
# TRANSLATION_MEMORY_CACHE_ENTRIES=5000
# TRANSLATION_DYNAMIC_ROUTING=true
# TENCENT_FREE_QUOTA_GUARDED=false

# 所有可能计费线路（含 DeepSeek、cheapApi 和自定义线路）默认阻断。
# 启用时必须同时设置 true、正数每日预算和正数单次上限，并选择请求模式。
# PAID_PROVIDER_ENABLED=false
# DAILY_PAID_BUDGET_CNY=0
# PAID_REQUEST_MAX_CNY=0.02
# PAID_FALLBACK_MODE=never
# DATABASE_URL=sqlite:///./data/soda_content.db

# CONTENT_DISCOVERY_MIN=500
# CONTENT_DISCOVERY_MAX=2000
# CONTENT_TARGET_CLUSTERS=30
# CONTENT_TIMEZONE=Asia/Shanghai
# CONTENT_ACTIVE_CEFR_LEVELS=A2,B1,B2,C1
# CONTENT_MAX_DAILY_VARIANTS=12
# CONTENT_PUBLISH_OFFSET_DAYS=0
# CONTENT_SOURCE_TIMEOUT_SECONDS=25
# CONTENT_PER_DOMAIN_CONCURRENCY=2
# CONTENT_AUTO_PUBLISH=true
# CONTENT_PREFER_ORIGINAL=true
# CONTENT_USER_AGENT=SodaReading/0.1 (English reading prototype; +https://github.com/liusucheng0213/soda-reading)

# 采集维基等来源时写入 From 与 mailto；使用自己的联系邮箱
CONTENT_CONTACT_EMAIL=

# EDITORIAL_PROVIDER_ORDER=deepseek,zhipu,modelscope
# EDITORIAL_PROVIDER_TIMEOUT_MS=30000
# EDITORIAL_TOTAL_TIMEOUT_MS=75000

# 只被 backend/scripts/run_daily_content.py 读取。不设置时使用 CONTENT_DISCOVERY_MIN
# CONTENT_RUN_LIMIT=500
