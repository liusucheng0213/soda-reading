    "@soda-reading/core": "0.1.0",
    "@vitejs/plugin-react": "5.0.4",
    "fflate": "^0.8.3",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "vite": "^6.4.5"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "vitest": "^5.0.5"
  }
}
