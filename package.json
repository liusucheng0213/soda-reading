{
  "name": "soda-reading",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:web": "vitest run",
    "build:web": "vite build",
    "build:admin": "vite build --mode admin --outDir dist-admin",
    "typecheck:mobile": "npm run typecheck -w @soda-reading/mobile",
    "test:all": "npm run test:web && npm run typecheck:mobile",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "test:supabase": "node scripts/test-supabase-rls.mjs",
    "test:edge": "node scripts/test-edge-functions.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.6",
    "@fontsource/newsreader": "5.2.8",
    "@phosphor-icons/react": "2.1.10",
    "@soda-reading/api-client": "0.1.0",
    "@soda-reading/core": "0.1.0",
    "@supabase/supabase-js": "2.110.8",
    "@vitejs/plugin-react": "5.0.4",
    "fflate": "0.8.2",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-worklets": "0.10.0",
    "ts-fsrs": "5.4.1",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "vitest": "3.2.4"
  }
}
