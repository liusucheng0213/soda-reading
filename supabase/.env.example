# Supabase provides these automatically to deployed Edge Functions.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=LOCAL_ANON_KEY_FROM_SUPABASE_STATUS
SUPABASE_SERVICE_ROLE_KEY=LOCAL_SERVICE_ROLE_KEY_FROM_SUPABASE_STATUS

ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Free-only model routes. Never place these in a VITE_ or EXPO_PUBLIC_ variable.
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.7-flash
MODELSCOPE_ACCESS_TOKEN=
MODELSCOPE_MODEL=Qwen/Qwen3.5-35B-A3B
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_FREE_MODELS=Qwen/Qwen2.5-7B-Instruct
TRANSLATION_PROVIDER_TIMEOUT_MS=2200
TRANSLATION_TOTAL_TIMEOUT_MS=4800
TRANSLATION_DAILY_USER_LIMIT=500

# Admin manual content trigger.
GITHUB_REPOSITORY=OWNER/PRIVATE_REPOSITORY
GITHUB_WORKFLOW_TOKEN=
GITHUB_WORKFLOW_REF=main
